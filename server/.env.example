NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ict_incident_tracker
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated allowlist for local and production browser origins.
CLIENT_URL=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ENABLE_SOCKET=true
CSV_EXPORT_DIR=./exports
ATTACHMENT_STORAGE=local
S3_REGION=us-east-1
S3_BUCKET=ict-attachments
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/ict-attachments
